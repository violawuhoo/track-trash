# 《好垃》后端环境变量示例。复制为 .env 后按需修改。
# 本地默认即可跑（SQLite 落在 ./data/saves.db）。

# 监听端口（dev:api 默认 8787）
PORT=8787
HOST=0.0.0.0

# SQLite 文件路径（本地开发）。生产走 DATABASE_URL 时忽略此项。
SQLITE_FILE=data/saves.db

# 生产数据库连接（Neon 等）。以 postgres:// 开头即切换为 Postgres 驱动。
# DATABASE_URL=postgres://user:pass@host.neon.tech/haola

# 允许跨域的前端域名（逗号分隔）。留空则反射请求来源（开发期方便）。
# WEB_ORIGIN=https://your-name.github.io

# 每个设备每分钟请求上限
RATE_LIMIT=60

# 应用版本（用于 /health 展示）
APP_VERSION=0.1.0
